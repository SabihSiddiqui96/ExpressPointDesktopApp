# ExpressPoint test automation — environment template.
# Copy this file to ".env" and fill in real values. ".env" is gitignored and
# must NEVER be committed. A fresh clone reproduces the project via:
#   git clone … && npm install && cp .env.example .env  (then fill in values)

# --- ExpressPoint app login (encrypted password flow; see utils/env.ts + utils/crypto.ts) ---
EP_USERNAME=
EP_CRYPTO_KEY=
EP_PASSWORD_ENC=

# --- PrimeroEdge WEB admin login (used by utils/primeroedge-web.ts) ---
# NOTE: these are currently hardcoded as fallbacks in primeroedge-web.ts — they
# should be moved here and the hardcoded values removed + rotated.
PRIMEROEDGE_WEB_USERNAME=
PRIMEROEDGE_WEB_PASSWORD=

# --- Azure DevOps (test-case fetch helper, scripts/ado-workitem.js) ---
# Read-only + Test Management Read scope (Work Items Write only if title-tagging).
AZURE_DEVOPS_PAT=

# --- RingCentral incoming webhook (regression reporter + scripts/notify.js) ---
# Paste your incoming-webhook URL from the RingCentral app.
RINGCENTRAL_WEBHOOK_URL=

# Optional: port the local webhook server listens on (default 5678)
WEBHOOK_PORT=5678

# Test run mode: "qa" (no webhook) or "regression" (fires webhook).
# Managed by scripts/set-mode.js — value here is just the default.
TEST_MODE=qa
